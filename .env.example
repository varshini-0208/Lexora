# ===================================================
# LEXORA - Legal Document Assistant Environment Configuration
# ===================================================

# Server Secret for Session Signing / JWT (required in production)
AUTH_SECRET=lexora_super_secret_session_jwt_key_2026_change_in_prod

# Google Gemini GenAI API Key (optional: local grounded legal analyzer operates automatically if omitted)
# Obtain your key from: https://aistudio.google.com/app/apikey
AI_API_KEY=
GEMINI_API_KEY=

# MongoDB URI (optional: automatically falls back to local file storage .data/lexora_db.json if omitted)
MONGODB_URI=

# Node Environment
NODE_ENV=development

# Next Public Site URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
